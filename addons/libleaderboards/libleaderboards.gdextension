[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]
linux.debug.x86_64 =   "res://../libleaderboards/rust/target/debug/liblibleaderboards.so"
windows.debug.x86_64 = "res://../libleaderboards/rust/target/debug/libleaderboards.dll"

linux.release.x86_64 =   "liblibleaderboards.so"
windows.release.x86_64 = "libleaderboards.dll"
