tweak_title_text = "mouse input in menus"
tweak_description_text = "you will be able to select and interact with menu controls such as this one using your mouse cursor."

[node name="HBoxContainer18" parent="Tweaks" instance=ExtResource("15_mxo6u")]
layout_mode = 2
tweak_name = "console_enabled"
lock_behind_story_mode = true
tweak_title_text = "enable console (f1 key)"
tweak_description_text = "gives an ability to toggle a debug console with f1 key on a keyboard.

caution: be extremely careful with console commands, as they are not intended for an average player! do not report any bugs encountered while using the console.
use at your own risk!

note: enabling this tweak will disable achievement progression!
to restore minix entry & achievements if still disabled, please, restart the game."

