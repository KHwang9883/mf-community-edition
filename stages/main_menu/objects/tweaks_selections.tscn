[node name="HBoxContainer28" type="HBoxContainer" parent="QuickSkinSettings"]
layout_mode = 2
script = ExtResource("18_ulbsg")
tweak_description_text = "closes the game and starts up the skin editor, where you can create a new skin and edit and fine-tune existing skins. after the game is closed, you will have to start it up again yourself.

the skin editor is a GUI tool made to conveniently configure how your skin is going to look like and how it is going to be animated.

as an alternative to the skin editor, you can edit the 'skin_settings.tres' files in a text editor, but before doing so, please read the skin guide!"
