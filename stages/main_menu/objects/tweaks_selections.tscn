[node name="HBoxContainerSoundtrack" type="HBoxContainer" parent="Aesthetic"]
layout_mode = 2
script = ExtResource("2_eijug")
tweak_name = "bgm_as_in_version"
tweak_description_text = "Select which version of Mario Forever the soundtrack should be based upon.

A \"Mixed\" soundtrack is a mix of these versions, which is generally based on the version period between 2.16 and 4.4, but with a few additions from 7.02.

The following levels are affected: 2-2, 2-3, 4-3, 6-2, 7-2, Hardcore 1-4, Human Laboratory (all levels), the Mario Minix \"Classic\" soundtrack type, all Bowser battles, and some custom levels from the community edition zone."

