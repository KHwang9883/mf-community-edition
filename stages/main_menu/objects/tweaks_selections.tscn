[node name="HBoxContainer20" parent="Presets" instance=ExtResource("15_mxo6u")]
layout_mode = 2
tweak_name = "load_save_from_world_start"
tweak_title_text = "save pipe: always first level of the world"
tweak_description_text = "copies the behavior over from the original game, where save pipes ignore the level you were on.

notice: enabling this tweak will not reset your save pipe until you enter it.

notice 2: enabling this tweak will disable level selector after beating the game. world selector is unaffected."

[node name="HBoxContainer16" parent="Presets" instance=ExtResource("15_mxo6u")]
layout_mode = 2
tweak_name = "f3_keybind"
tweak_title_text = "f3 keybind to save game room"
tweak_description_text = "enables a quick shortcut to save game room using f3 key.

attention: pressing f3 will automatically skip the progress continue screen! to show it, use \"go to save room\" option from pause menu.

notice: if you are in options and have not selected \"exit\" (or escape key) to go back, pressing f3 will not save the options you've changed! it will also not reset the scene if you're already in save room."

[node name="HBoxContainer17" parent="Presets" instance=ExtResource("15_mxo6u")]
layout_mode = 2
tweak_name = "f4_keybind"
tweak_title_text = "f4 keybind to main menu"
tweak_description_text = "enables a quick shortcut to main menu using f4 key.

notice: you cannot reset the scene if you are already in main menu."

[node name="HBoxContainer18" parent="Presets" instance=ExtResource("15_mxo6u")]
layout_mode = 2
tweak_name = "additional_save_pipes"
default_value = true
tweak_title_text = "more save pipes in save room"
tweak_description_text = "adds paging to story mode save profiles (as bumpable blocks), for a total of 9 saves.

notice: disabling this tweak will not reset your save data, but other saves may become inaccessible until you toggle it back on."

[node name="HBoxContainer21" parent="Presets" instance=ExtResource("15_mxo6u")]
layout_mode = 2
tweak_name = "revamp_item_shop"
tweak_title_text = "require pressing up in item shop"
tweak_description_text = "if disabled, touching a power-up in save room item shop will immediately buy an item.

if enabled, it also requires the player to press the moving up key in order to buy an item."

[node name="HBoxContainer22" parent="Presets" instance=ExtResource("15_mxo6u")]
layout_mode = 2
tweak_name = "show_warning_on_revamped_levels"
default_value = true
tweak_title_text = "show a warning before playing
revamped levels"
tweak_description_text = "if enabled, shows a message about revamped levels before playing one and lets the player choose which variant to play.

if disabled, skips straight to the level, based on if the \"revamp level design\" tweak is enabled or not."

