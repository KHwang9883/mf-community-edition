[node name="HBoxContainer27" parent="Aesthetic" instance=ExtResource("15_mxo6u")]
layout_mode = 2
tweak_name = "replace_circle_transitions_with_fades"
tweak_title_text = "replace circle transitions with crossfades"
tweak_description_text = "If enabled, crossfades will replace nearly all circle transitions between scenes, pausing the game in the process.
Such transitions take slightly less time than the default circle ones.

This behavior is similar to versions 5.0+ of the original game."

[node name="HBoxContainer3" parent="Aesthetic" instance=ExtResource("15_mxo6u")]
layout_mode = 2
tweak_name = "bgm_fade_in_bug_emulation"
tweak_title_text = "soundtrack fade-in bug simulation"
tweak_description_text = "each time a new soundtrack plays, the beginning makes a fade-in effect, similar to a bug in versions 5.08 - 6.0."

[node name="HBoxContainer8" parent="Aesthetic" instance=ExtResource("15_mxo6u")]
layout_mode = 2
tweak_name = "alt_completion_music"
tweak_title_text = "alternative level complete soundtrack
(from 2.16+)"
tweak_description_text = "enables a \"softendo mix\" version of the course clear soundtrack; otherwise, it will play a regular smw one."

[node name="HBoxTweakBool" parent="Aesthetic" instance=ExtResource("15_mxo6u")]
layout_mode = 2
tweak_name = "enable_smooth_cam_transitions"
default_value = true
tweak_title_text = "smooth camera transitions between areas"
tweak_description_text = "smoothes out camera movement between certain areas, such as the save game room and hardcore world 1-3."
metadata/_edit_pinned_properties_ = [&"default_value"]

[node name="HBoxTweakBool2" parent="Aesthetic" instance=ExtResource("15_mxo6u")]
layout_mode = 2
tweak_name = "enable_blur_transitions"
default_value = true
tweak_title_text = "blur transitions between pipe warp areas"
tweak_description_text = "adds a blur transition each time the player warps into a new area mid-level. disable this tweak to make the new area load immediately."
metadata/_edit_pinned_properties_ = [&"default_value"]

[node name="HBoxTweakBool4" parent="Aesthetic" instance=ExtResource("15_mxo6u")]
layout_mode = 2
tweak_name = "pause_on_suit_change"
default_value = false
tweak_title_text = "pause on player suit change"
tweak_description_text = "each time the player receives a powerup or takes damage, the entire game pauses for a second, giving the user more time to react."
metadata/_edit_pinned_properties_ = [&"default_value"]

[node name="HBoxContainer17" parent="Aesthetic" instance=ExtResource("15_mxo6u")]
layout_mode = 2
tweak_name = "player_skid_animation"
tweak_title_text = "player skidding effects"
tweak_description_text = "enables the skidding animation and particles, similar to something you would see in other mario games.

note: this tweak does not affect gameplay in any way!"

[node name="HBoxContainer21" parent="Aesthetic" instance=ExtResource("15_mxo6u")]
layout_mode = 2
tweak_name = "secrets_notification"
default_value = true
tweak_title_text = "achievement notifications"
tweak_description_text = "each time an achievement gets unlocked or progresses further, a pop-up will appear for a few seconds, and, if unlocked, a sound effect will play."

[node name="HBoxContainer22" parent="Aesthetic" instance=ExtResource("15_mxo6u")]
layout_mode = 2
tweak_name = "save_icon"
tweak_title_text = "progress save indication"
tweak_description_text = "each time the game saves your progress, a save icon will appear in the corner."

